<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_visualizador_pdf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_visualizador_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_visualizador_pdf"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/desc_voltar_visualizador_pdf"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:subtitle="@string/subtitulo_visualizador_pdf_offline"
            app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
            app:subtitleTextColor="@color/primary_light"
            app:title="@string/titulo_visualizador_pdf_offline"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_visualizador_pdf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/container_conteudo_visualizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/md3_screen_padding_horizontal"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/md3_screen_padding_horizontal"
            android:paddingBottom="28dp">

            <!-- Card de Status de Armazenamento Local e Ações de Salvamento -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_metadados_pdf_offline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/md3_corner_extra_large"
                app:cardElevation="@dimen/md3_card_elevation_flat"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_folder_offline"
                            app:tint="@color/md3_on_safe_container" />

                        <TextView
                            android:id="@+id/tv_nome_residente_pdf"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            tools:text="Dona Francisca de Souza" />

                        <TextView
                            android:id="@+id/tv_badge_offline_pdf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_blood"
                            android:backgroundTint="@color/md3_safe_container"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/badge_arquivo_offline_ativo"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/md3_on_safe_container"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_metadados_arquivo_pdf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/text_secondary"
                        tools:text="Resumo_Prontuario_ID1.pdf • 12,4 KB • Salvo em 27/10/2026 às 06:40" />

                    <!-- Linha 1: Salvar em Downloads / Escolher Pasta Local (SAF) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_salvar_downloads_rapido"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="@dimen/md3_touch_target_min"
                            android:text="@string/btn_salvar_downloads_rapido"
                            android:textColor="@color/white"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="@dimen/md3_corner_medium"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_escolher_pasta_local"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="@dimen/md3_touch_target_min"
                            android:text="@string/btn_escolher_pasta_local"
                            android:textColor="@color/on_primary_container"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary_container"
                            app:cornerRadius="@dimen/md3_corner_medium"
                            app:icon="@drawable/ic_folder_offline"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/on_primary_container" />
                    </LinearLayout>

                    <!-- Linha 2: Compartilhar / Abrir em Leitor Externo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_compartilhar_resumo_viewer"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="@dimen/md3_touch_target_min"
                            android:text="@string/acao_compartilhar_pdf"
                            android:textColor="@color/primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/md3_corner_medium"
                            app:icon="@drawable/ic_picture_as_pdf"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/primary"
                            app:strokeColor="@color/primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_abrir_leitor_externo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="@dimen/md3_touch_target_min"
                            android:text="@string/btn_abrir_leitor_externo"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/md3_corner_medium"
                            app:strokeColor="@color/divider" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Container das Páginas A4 Renderizadas 100% Offline via PdfRenderer -->
            <LinearLayout
                android:id="@+id/container_paginas_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Mensagem informativa caso o ambiente não suporte renderização gráfica nativa -->
            <TextView
                android:id="@+id/tv_aviso_fallback_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_md3_container_rounded"
                android:backgroundTint="@color/md3_clinical_container"
                android:padding="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md3_on_clinical_container"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
