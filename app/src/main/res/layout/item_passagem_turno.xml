<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_passagem_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Linha 1: Turno + Prioridade + Data/Hora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_badge_turno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_blood"
                android:backgroundTint="@color/primary_container"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/on_primary_container"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="Turno: Manhã" />

            <TextView
                android:id="@+id/tv_badge_prioridade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_blood"
                android:backgroundTint="@color/danger_light"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/danger_red"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="URGENTE" />

            <TextView
                android:id="@+id/tv_data_hora_passagem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp"
                tools:text="24/11/2026 07:30" />
        </LinearLayout>

        <!-- Residente ou Geral -->
        <TextView
            android:id="@+id/tv_nome_idoso_passagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Seu Antônio Carlos Ribeiro" />

        <!-- Profissional que registrou -->
        <TextView
            android:id="@+id/tv_autor_passagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/primary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Registrado por: Enf. Camila Mendes • Enfermeiro(a)" />

        <!-- Observações principais -->
        <TextView
            android:id="@+id/tv_observacoes_passagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Apresentou leve instabilidade postural ao levantar. Estoque de Prolopa com 4 comprimidos restantes." />

        <!-- Intercorrências -->
        <TextView
            android:id="@+id/tv_intercorrencias_passagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_box"
            android:backgroundTint="@color/m3_surface_container_low"
            android:padding="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:visibility="gone"
            tools:text="Intercorrências: Necessário auxílio integral no deslocamento."
            tools:visibility="visible" />

        <!-- Pendências p/ próximo turno -->
        <TextView
            android:id="@+id/tv_pendencias_passagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_box"
            android:backgroundTint="@color/vagas_alerta_bg"
            android:padding="10dp"
            android:textColor="@color/vagas_alerta_fg"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Pendência p/ próximo turno: Confirmar reposição de Prolopa."
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/surface_variant" />

        <!-- Rodapé de Conferência e Ações -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_status_conferencia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/success_green"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_check"
                app:drawableTint="@color/success_green"
                tools:text="Conferido por Enf. Camila às 08:00" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirmar_recebimento"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_confirmar_recebimento_turno"
                android:textColor="@color/on_primary_container"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_container"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/on_primary_container" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_excluir_passagem"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/desc_excluir_passagem_turno"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/danger_red"
                app:strokeColor="@color/danger_red" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
