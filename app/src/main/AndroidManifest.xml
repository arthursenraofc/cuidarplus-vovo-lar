<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão nativa para captura de foto via Câmera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Permissões nativas para alarmes, boot e notificações (Sprint 2 Avançado) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Queries para resolução de Intents da Câmera, WhatsApp, SMS e leitores/compartilhadores de PDF no Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LarIdosos">

        <!-- FileProvider para prover URIs seguras da câmera e documentos PDF sem FileUriExposedException -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 1. ÚNICA Activity de Inicialização (MAIN / LAUNCHER): Módulos e Operação Diária (Sprint 3) -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1b. Tela Dedicada de Dashboard & Indicadores da Instituição (Material Design 3) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:label="@string/titulo_dashboard_instituicao"
            android:parentActivityName=".MainActivity" />

        <!-- 2. Lista e Fichas dos Idosos com busca -->
        <activity
            android:name=".ListaIdososActivity"
            android:exported="false"
            android:label="@string/titulo_lista_idosos"
            android:parentActivityName=".MainActivity" />

        <!-- 3. Cadastro e Edição de Idoso com Câmera e Validações -->
        <activity
            android:name=".CadastroIdosoActivity"
            android:exported="false"
            android:label="@string/titulo_cadastro_idoso"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Ficha Detalhada / Prontuário Clínico do Idoso -->
        <activity
            android:name=".DetalhesIdosoActivity"
            android:exported="false"
            android:label="@string/titulo_detalhes_idoso" />

        <!-- 4b. Visualizador Nativo de Resumo PDF Salvo Offline -->
        <activity
            android:name=".VisualizadorPdfOfflineActivity"
            android:exported="false"
            android:label="@string/titulo_visualizador_pdf_offline" />

        <!-- 5. Lista de Medicamentos do Residente (Sprint 2) -->
        <activity
            android:name=".ListaMedicamentosActivity"
            android:exported="false"
            android:label="@string/titulo_lista_medicamentos"
            android:parentActivityName=".MainActivity" />

        <!-- 5b. Gestão de Medicamentos com RBAC (MedicamentoActivity) -->
        <activity
            android:name=".MedicamentoActivity"
            android:exported="false"
            android:label="@string/titulo_lista_medicamentos"
            android:parentActivityName=".MainActivity" />

        <!-- 6. Cadastro de Medicamento e Alarme (Sprint 2) -->
        <activity
            android:name=".CadastroMedicamentoActivity"
            android:exported="false"
            android:label="@string/titulo_cadastro_medicamento"
            android:windowSoftInputMode="adjustResize" />

        <!-- 7. Edição e Refinamento de Medicamento (Sprint 2 Avançado) -->
        <activity
            android:name=".EditarMedicamentoActivity"
            android:exported="false"
            android:label="@string/titulo_editar_medicamento"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Controle Geral de Estoque de Medicamentos e Relatórios PDF -->
        <activity
            android:name=".EstoqueActivity"
            android:exported="false"
            android:label="@string/titulo_estoque"
            android:parentActivityName=".MainActivity" />

        <!-- 1. BroadcastReceiver para Alarmes e Notificações de Medicamento (MedicamentoReceiver) -->
        <receiver
            android:name=".receiver.MedicamentoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.cuidarplus.ACTION_DISPARAR_ALARME" />
                <action android:name="com.example.cuidarplus.ACTION_MARCAR_ADMINISTRADO" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver legado para compatibilidade retroativa -->
        <receiver
            android:name=".receiver.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.cuidarplus.ACTION_MARCAR_ADMINISTRADO" />
            </intent-filter>
        </receiver>

        <!-- 2. BroadcastReceiver para Restauração Automática de Alarmes no Boot (BootReceiver) -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
